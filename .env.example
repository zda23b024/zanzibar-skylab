# Zanzibar SkyLab is a 100% client-side deterministic astronomical observatory.
# All celestial calculations run locally in the browser via astronomy-engine.
# No external LLM or backend API keys are required.

# APP_URL: The URL where this applet is hosted.
APP_URL="https://zanzibar-skylab.vercel.app/"

# Set false and rebuild to remove the optional competition recording entry point.
VITE_COMPETITION_DEMO=true

# Optional professional narration: public relative asset path, no secrets.
# VITE_DEMO_NARRATION_PATH="audio/professional-narration.en.mp3"
# VITE_DEMO_NARRATION_LABEL="Approved English narration"
